# OpenAI-compatible gateway base URL, without /chat/completions.
OPENAI_BASE_URL=https://api.flowist.dev/v1
# Use an available model ID from your gateway, including any provider prefix.
OPENAI_MODEL=sub2apigpt/gpt-6.1-sol
# Sent as Authorization: Bearer. Keep real credentials in .env or GitHub Secrets.
OPENAI_API_KEY=
# Optional: number of concurrent translation requests (default 2).
OPENAI_API_CONCURRENT=2
